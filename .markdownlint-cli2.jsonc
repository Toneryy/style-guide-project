// Настройки markdownlint – проверка разметки по разделу «Правила Markdown».
{
  "config": {
    "default": true,
    // Заголовки только через #
    "MD003": { "style": "atx" },
    // Маркер списка – дефис
    "MD004": { "style": "dash" },
    // Вложенные списки – 4 пробела, иначе MkDocs их не распознает
    "MD007": { "indent": 4 },
    // Длину строки не ограничиваем: абзац пишется в одну строку
    "MD013": false,
    // Одинаковые заголовки допустимы в разных разделах
    "MD024": { "siblings_only": true },
    // Нумерация списков по порядку: 1, 2, 3
    "MD029": { "style": "ordered" },
    // Только огороженные блоки кода
    "MD046": { "style": "fenced" },
    "MD048": { "style": "backtick" },
    // Жирный – через **
    "MD050": { "style": "asterisk" }
  },
  "globs": ["**/*.md"],
  "ignores": ["node_modules/**", "site/**", ".venv/**", "venv/**", ".github/**"]
}
